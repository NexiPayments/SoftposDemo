<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background_activity"
    tools:context=".activities.AccountingClosureInsertValuesActivity">

    <TextView
        android:id="@+id/textViewHeaderCloseAccount"
        android:layout_width="215dp"
        android:layout_height="38dp"
        android:layout_marginTop="48dp"
        android:text="Accounting closure ins. values"
        android:textAlignment="center"
        android:layout_gravity="center"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutCallerTrxIdCloseAccount"
            android:layout_width="300dp"
            android:layout_height="74dp"
            android:layout_marginTop="40dp"
            android:layout_gravity="center"
            android:hint="CallerTrxId">

            <EditText
                android:id="@+id/editTextCallerTrxIdCloseAccount"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ems="10"
                android:inputType="text"

                />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnAvviaCloseAccount"
            android:layout_width="207dp"
            android:layout_height="62dp"
            android:layout_marginTop="20dp"
            android:layout_gravity="center"
            android:text="Accounting closure"
            android:backgroundTint="@color/color_background_button"
            />

    </LinearLayout>

</LinearLayout>