<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background_activity"
    tools:context=".activities.MainActivity">


    <TextView
        android:id="@+id/textViewHeader"
        android:layout_width="326dp"
        android:layout_height="32dp"
        android:layout_marginTop="40dp"
        android:layout_gravity="center"
        android:text="Spoftpos Base Java Light"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewVersioneApp"
        android:layout_width="316dp"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        android:text="Version"
        android:textAlignment="center"
        android:layout_gravity="center"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnPayment"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginTop="40dp"
                android:layout_gravity="center"
                android:backgroundTint="@color/color_background_button"
                android:text="Payment" />

            <Button
                android:id="@+id/btnReversal"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginTop="30dp"
                android:layout_gravity="center"
                android:backgroundTint="@color/color_background_button"
                android:text="Reversal" />

            <Button
                android:id="@+id/btnLastTransaction"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginTop="30dp"
                android:layout_gravity="center"
                android:text="Last transaction"
                android:backgroundTint="@color/color_background_button"
                />

            <Button
                android:id="@+id/btnCloseAccount"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginTop="30dp"
                android:layout_gravity="center"
                android:text="Accounting closure"
                android:backgroundTint="@color/color_background_button"

                />


        </LinearLayout>

    </ScrollView>

</LinearLayout>