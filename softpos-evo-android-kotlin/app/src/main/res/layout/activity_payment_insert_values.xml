<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background_activity"
    tools:context=".activities.PaymentInsertValuesActivity"
    android:orientation="vertical"
    >

    <TextView
        android:id="@+id/textViewPaymentHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Payment insert values - EVO"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutAmount"
                android:layout_width="@dimen/edittext_width"
                android:layout_height="@dimen/edittext_height"
                android:layout_marginTop="20dp"
                android:hint="Amount">

                <EditText
                    android:id="@+id/editTextAmount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ems="10"
                    android:inputType="numberDecimal" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textLayoutInputCallerTrxId"
                android:layout_width="@dimen/edittext_width"
                android:layout_height="@dimen/edittext_height"
                android:layout_marginTop="@dimen/edittext_margin_top"
                android:hint="callerTrxId">

                <EditText
                    android:id="@+id/editTextCallerTrxId"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ems="5"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textLayoutInputEmail"
                android:layout_width="@dimen/edittext_width"
                android:layout_height="@dimen/edittext_height"
                android:layout_marginTop="@dimen/edittext_margin_top"
                android:hint="Email">

                <EditText
                    android:id="@+id/editTextEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ems="10"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textLayoutInputSms"
                android:layout_width="@dimen/edittext_width"
                android:layout_height="@dimen/edittext_height"
                android:layout_marginTop="@dimen/edittext_margin_top"
                android:hint="Sms">

                <EditText
                    android:id="@+id/editTextSms"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ems="10"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/edittext_margin_top"
                android:orientation="horizontal"
                >

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textLayoutInputAddInfo1"
                    android:layout_width="90dp"
                    android:layout_height="@dimen/edittext_height"
                    android:hint="Add1">

                    <EditText
                        android:id="@+id/editTextAddInfo1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:ems="10"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textLayoutInputAddInfo2"
                    android:layout_width="90dp"
                    android:layout_height="@dimen/edittext_height"
                    android:layout_marginLeft="3dp"
                    android:hint="Add2">

                    <EditText
                        android:id="@+id/editTextAddInfo2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:ems="10"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textLayoutInputAddInfo3"
                    android:layout_width="90dp"
                    android:layout_height="@dimen/edittext_height"
                    android:layout_marginLeft="3dp"
                    android:hint="Add3">

                    <EditText
                        android:id="@+id/editTextAddInfo3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:ems="10"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>


            </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            >

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textLayoutInputAddInfo4"
                android:layout_width="90dp"
                android:layout_height="@dimen/edittext_height"
                android:hint="Add4">

                <EditText
                    android:id="@+id/editTextAddInfo4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ems="10"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textLayoutInputAddInfo5"
                android:layout_width="90dp"
                android:layout_height="@dimen/edittext_height"
                android:layout_marginLeft="3dp"
                android:hint="Add5">

                <EditText
                    android:id="@+id/editTextAddInfo5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ems="10"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/edittext_margin_top"
                android:orientation="horizontal"
                >

                <CheckBox
                    android:id="@+id/checkBoxAutoClose"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/checkbox_height"
                    android:checked="false"
                    android:text="AutoClose" />

                <CheckBox
                    android:id="@+id/checkBoxUrlTicket"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/checkbox_height"
                    android:layout_marginLeft="5dp"
                    android:checked="false"
                    android:text="urlTicket" />

                <CheckBox
                    android:id="@+id/checkBoxHideRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/checkbox_height"
                    android:layout_marginLeft="5dp"
                    android:checked="false"
                    android:text="HiRe" />

            </LinearLayout>


            <Button
                android:id="@+id/btnStartPayment"
                android:layout_width="200dp"
                android:layout_height="@dimen/button_height"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/color_background_button"
                android:text="Payment" />

        </LinearLayout>

    </ScrollView>


</LinearLayout>