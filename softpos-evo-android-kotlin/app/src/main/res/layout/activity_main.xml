<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background_activity"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    tools:context=".activities.MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Softpos - EVO - Kotlin"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textStyle="bold"
        />

    <TextView
        android:id="@+id/textViewVersionApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_gravity="center"
        android:text="Version"
        android:textAlignment="center"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            >

            <Button
                android:id="@+id/btnPayment"
                android:layout_width="@dimen/button_width"
                android:layout_height="@dimen/button_height"
                android:backgroundTint="@color/color_background_button"
                android:text="Payment" />

            <Button
                android:id="@+id/btnReversal"
                android:layout_width="@dimen/button_width"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/color_background_button"
                android:text="Reversal" />

            <Button
                android:id="@+id/btnLastTransaction"
                android:layout_width="@dimen/button_width"
                android:layout_height="@dimen/button_height"

                android:layout_marginTop="10dp"
                android:backgroundTint="@color/color_background_button"
                android:text="Last trans" />


            <Button
                android:id="@+id/btnCloseAccount"
                android:layout_width="@dimen/button_width"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/color_background_button"
                android:text="CloseAccount Mpos only" />

            <TextView
                android:id="@+id/textViewStatoConnessioneSDK"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                android:text="WAITING SDK"
                android:textAlignment="center"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>