<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background_activity"
    tools:context=".activities.CloseAccountInsertValuesActivity"
    android:orientation="vertical"
    >

    <TextView
        android:id="@+id/textViewCloseAccountHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="CloseAccount insert values - EVO"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textStyle="bold"
        />

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutCallerTrxId"
                android:layout_width="@dimen/edittext_width"
                android:layout_height="@dimen/edittext_height"
                android:layout_marginTop="@dimen/edittext_margin_top"
                android:hint="CallerTrxId">

                <EditText
                    android:id="@+id/editTextCallerTrxId"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ems="10"
                    android:inputType="text"

                    />

            </com.google.android.material.textfield.TextInputLayout>


            <Button
                android:id="@+id/btnStartCloseAccount"
                android:layout_width="200dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                android:backgroundTint="@color/color_background_button"
                android:text="CloseAccount" />

        </LinearLayout>

    </ScrollView>


</LinearLayout>