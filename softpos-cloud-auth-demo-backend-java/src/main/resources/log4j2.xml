<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="ERROR">
    <Properties>
        <Property name="basePath">C:\\NetBeans Projects\\Log4j\\softpos-cloud-auth-demo-backend-java</Property> 
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ} %p %m%n</Property>        
    </Properties>
        
    <Appenders>        
        <RollingFile name="infoLog" fileName="${basePath}/softpos-backend-cloud-auth-java-info-${date:dd-MM-yyyy}.log"
            filePattern="${basePath}/TestSoftPosB2B-info-%d{yyyy-MM-dd}-%i.log" >
            <LevelRangeFilter minLevel="INFO" maxLevel="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="19500KB" />
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
         
        <RollingFile name="errorLog" fileName="${basePath}/softpos-backend-cloud-auth-java-error-${date:dd-MM-yyyy}.log"
            filePattern="${basePath}/TestSoftPosB2B-error-%d{yyyy-MM-dd}-%i.log" >
            <LevelRangeFilter minLevel="ERROR" maxLevel="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="19500KB" />
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
        
         <RollingFile name="debugLog" fileName="${basePath}/softpos-backend-cloud-auth-java-debug-${date:dd-MM-yyyy}.log"
            filePattern="${basePath}/TestSoftPosB2B-debug-%d{yyyy-MM-dd}-%i.log" >
            <LevelRangeFilter minLevel="DEBUG" maxLevel="DEBUG" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="19500KB" />
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
        
    </Appenders>
   
    <Loggers>
        <Logger name="it.nexi.softpos_cloud_auth" additivity="false">
            <AppenderRef ref="infoLog"  />
            <AppenderRef ref="errorLog" />
            <AppenderRef ref="debugLog" />
        </Logger>
        <Root level="DEBUG">
            <!--<AppenderRef ref="SYSLOG"  />-->
            <AppenderRef ref="infoLog"  />
            <AppenderRef ref="errorLog" />
            <AppenderRef ref="debugLog" />
        </Root>
    </Loggers>    
   
</Configuration>
